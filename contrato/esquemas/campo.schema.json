{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "contrato 0.2.0",
  "$defs": {
    "Candidato": {
      "additionalProperties": false,
      "description": "Grupo de detecciones compatible con un movimiento; no es un descubrimiento.",
      "properties": {
        "id": {
          "description": "Identificador en kebab-case",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "detecciones": {
          "items": {
            "$ref": "#/$defs/Deteccion"
          },
          "minItems": 3,
          "type": "array"
        },
        "velocidad_arcsec_h": {
          "minimum": 0,
          "type": "number"
        },
        "angulo_posicion_grados": {
          "exclusiveMaximum": 360,
          "minimum": 0,
          "type": "number"
        },
        "residuo_arcsec": {
          "minimum": 0,
          "type": "number"
        },
        "falsas_alarmas_esperadas": {
          "description": "Enlaces espurios esperados (RF-21)",
          "minimum": 0,
          "type": "number"
        },
        "identificacion": {
          "$ref": "#/$defs/Identificacion"
        }
      },
      "required": [
        "id",
        "detecciones",
        "velocidad_arcsec_h",
        "angulo_posicion_grados",
        "residuo_arcsec",
        "falsas_alarmas_esperadas",
        "identificacion"
      ],
      "title": "Candidato",
      "type": "object"
    },
    "Coordenadas": {
      "additionalProperties": false,
      "description": "Punto del cielo en grados ICRS.",
      "properties": {
        "ra": {
          "description": "Ascensión recta ICRS en grados",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "type": "number"
        },
        "dec": {
          "description": "Declinación ICRS en grados",
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        }
      },
      "required": [
        "ra",
        "dec"
      ],
      "title": "Coordenadas",
      "type": "object"
    },
    "Deteccion": {
      "additionalProperties": false,
      "properties": {
        "epoca_id": {
          "description": "Identificador en kebab-case",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "ra": {
          "description": "Ascensión recta ICRS en grados",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "type": "number"
        },
        "dec": {
          "description": "Declinación ICRS en grados",
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        "snr": {
          "description": "Relación señal/ruido de la detección",
          "type": "number"
        }
      },
      "required": [
        "epoca_id",
        "x",
        "y",
        "ra",
        "dec",
        "snr"
      ],
      "title": "Deteccion",
      "type": "object"
    },
    "DeteccionDeConocido": {
      "additionalProperties": false,
      "description": "Dónde se midió un objeto conocido en una época y a cuánto quedó de lo esperado.",
      "properties": {
        "epoca_id": {
          "description": "Identificador en kebab-case",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "x": {
          "description": "Centroide medido, en píxeles de la rejilla",
          "type": "number"
        },
        "y": {
          "description": "Centroide medido, en píxeles de la rejilla",
          "type": "number"
        },
        "snr": {
          "description": "Relación señal/ruido de la medición",
          "type": "number"
        },
        "distancia_px": {
          "description": "Distancia a la posición esperada",
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "epoca_id",
        "x",
        "y",
        "snr",
        "distancia_px"
      ],
      "title": "DeteccionDeConocido",
      "type": "object"
    },
    "Epoca": {
      "additionalProperties": false,
      "description": "Un recorte usado en el campo.",
      "properties": {
        "id": {
          "description": "Identificador en kebab-case",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "mjd": {
          "description": "Inicio de la observación (time_bounds_lower) en MJD",
          "type": "number"
        },
        "fecha_utc": {
          "description": "Inicio de la observación en UTC",
          "format": "date-time",
          "type": "string"
        },
        "pasada": {
          "description": "Número de pasada de SPHEREx",
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        },
        "fuente": {
          "$ref": "#/$defs/FuenteDeEpoca"
        },
        "longitud_onda_um": {
          "description": "Longitud de onda central en el centro",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "fraccion_mala": {
          "description": "Fracción enmascarada por FLAGS",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "imagen": {
          "description": "Ruta relativa a web/public/datos/ (o servida por la API en el modo en vivo)",
          "minLength": 1,
          "type": "string"
        },
        "diferencia": {
          "anyOf": [
            {
              "description": "Ruta relativa a web/public/datos/ (o servida por la API en el modo en vivo)",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Diferencia contra la mediana de las otras épocas; null con menos de 3"
        }
      },
      "required": [
        "id",
        "mjd",
        "fecha_utc",
        "pasada",
        "fuente",
        "longitud_onda_um",
        "fraccion_mala",
        "imagen",
        "diferencia"
      ],
      "title": "Epoca",
      "type": "object"
    },
    "Estiramiento": {
      "additionalProperties": false,
      "description": "Escala de brillo común a todas las épocas del campo (RF-05).",
      "properties": {
        "tipo": {
          "enum": [
            "lineal",
            "asinh"
          ],
          "type": "string"
        },
        "minimo": {
          "description": "MJy/sr que se pintan negros",
          "type": "number"
        },
        "maximo": {
          "description": "MJy/sr que se pintan blancos",
          "type": "number"
        }
      },
      "required": [
        "tipo",
        "minimo",
        "maximo"
      ],
      "title": "Estiramiento",
      "type": "object"
    },
    "FuenteDeEpoca": {
      "additionalProperties": false,
      "description": "De qué archivo de IRSA salió la época (RF-15, RNF-07).",
      "properties": {
        "uri": {
          "description": "URI de IRSA del archivo L2",
          "pattern": "^https://",
          "type": "string"
        },
        "planeid": {
          "minLength": 1,
          "type": "string"
        },
        "version_proceso": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "uri",
        "planeid",
        "version_proceso"
      ],
      "title": "FuenteDeEpoca",
      "type": "object"
    },
    "Geometria": {
      "additionalProperties": false,
      "description": "Dónde estaban la Tierra y el objeto cuando se tomó cada época (JPL Horizons).\n\nLa escena 3D dibuja exactamente esta geometría, la misma que usó el\npipeline para marcar al objeto, en vez de recalcularla en el navegador.",
      "properties": {
        "marco": {
          "const": "heliocentrico-ecliptico-J2000",
          "type": "string"
        },
        "tierra": {
          "items": {
            "$ref": "#/$defs/PuntoHeliocentrico"
          },
          "type": "array"
        },
        "objeto": {
          "$ref": "#/$defs/ObjetoEnLaEscena"
        }
      },
      "required": [
        "marco",
        "tierra",
        "objeto"
      ],
      "title": "Geometria",
      "type": "object"
    },
    "Identificacion": {
      "additionalProperties": false,
      "properties": {
        "estado": {
          "enum": [
            "conocido",
            "sin-identificar"
          ],
          "type": "string"
        },
        "nombre": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "distancia_arcsec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "estado",
        "nombre",
        "distancia_arcsec"
      ],
      "title": "Identificacion",
      "type": "object"
    },
    "Limites": {
      "additionalProperties": false,
      "description": "Límites medidos por inyección de objetos falsos (RF-27).",
      "properties": {
        "umbral_sigma": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "profundidad_5sigma": {
          "$ref": "#/$defs/Profundidad"
        },
        "recuperacion": {
          "items": {
            "$ref": "#/$defs/PuntoDeRecuperacion"
          },
          "type": "array"
        }
      },
      "required": [
        "umbral_sigma",
        "profundidad_5sigma",
        "recuperacion"
      ],
      "title": "Limites",
      "type": "object"
    },
    "Magnitud": {
      "additionalProperties": false,
      "properties": {
        "valor": {
          "type": "number"
        },
        "banda": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "valor",
        "banda"
      ],
      "title": "Magnitud",
      "type": "object"
    },
    "ObjetoConocido": {
      "additionalProperties": false,
      "description": "Cuerpo del Sistema Solar o estrella de catálogo con posición esperada.",
      "properties": {
        "nombre": {
          "minLength": 1,
          "type": "string"
        },
        "tipo": {
          "enum": [
            "estrella",
            "asteroide",
            "cometa",
            "tno",
            "planeta-enano",
            "enana-marron"
          ],
          "type": "string"
        },
        "posiciones": {
          "items": {
            "$ref": "#/$defs/PosicionEsperada"
          },
          "type": "array"
        },
        "deteccion": {
          "description": "Mediciones en la imagen; vacía si no se midió",
          "items": {
            "$ref": "#/$defs/DeteccionDeConocido"
          },
          "type": "array"
        },
        "fuente": {
          "enum": [
            "SkyBoT",
            "Horizons",
            "SIMBAD",
            "Gaia DR3"
          ],
          "type": "string"
        },
        "consultado_en": {
          "format": "date-time",
          "type": "string"
        },
        "magnitud": {
          "anyOf": [
            {
              "$ref": "#/$defs/Magnitud"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "nombre",
        "tipo",
        "posiciones",
        "deteccion",
        "fuente",
        "consultado_en",
        "magnitud"
      ],
      "title": "ObjetoConocido",
      "type": "object"
    },
    "ObjetoEnLaEscena": {
      "additionalProperties": false,
      "description": "El cuerpo del Sistema Solar del campo, con su posición en cada época.",
      "properties": {
        "nombre": {
          "minLength": 1,
          "type": "string"
        },
        "posiciones": {
          "items": {
            "$ref": "#/$defs/PuntoHeliocentrico"
          },
          "type": "array"
        }
      },
      "required": [
        "nombre",
        "posiciones"
      ],
      "title": "ObjetoEnLaEscena",
      "type": "object"
    },
    "PosicionEsperada": {
      "additionalProperties": false,
      "description": "Dónde tenía que estar un objeto conocido en una época.",
      "properties": {
        "epoca_id": {
          "description": "Identificador en kebab-case",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "ra": {
          "description": "Ascensión recta ICRS en grados",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "type": "number"
        },
        "dec": {
          "description": "Declinación ICRS en grados",
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        "x": {
          "description": "Píxel de la rejilla, origen arriba a la izquierda",
          "type": "number"
        },
        "y": {
          "description": "Píxel de la rejilla, origen arriba a la izquierda",
          "type": "number"
        },
        "dentro_del_campo": {
          "type": "boolean"
        },
        "distancia_ua": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Distancia al observador en UA; null para las estrellas"
        }
      },
      "required": [
        "epoca_id",
        "ra",
        "dec",
        "x",
        "y",
        "dentro_del_campo",
        "distancia_ua"
      ],
      "title": "PosicionEsperada",
      "type": "object"
    },
    "Procedencia": {
      "additionalProperties": false,
      "description": "Con qué versión del pipeline y cuándo se consultó IRSA (RNF-12).",
      "properties": {
        "version_pipeline": {
          "minLength": 1,
          "type": "string"
        },
        "irsa_consultado_en": {
          "description": "Cuándo se buscaron las observaciones",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "version_pipeline",
        "irsa_consultado_en"
      ],
      "title": "Procedencia",
      "type": "object"
    },
    "Profundidad": {
      "additionalProperties": false,
      "properties": {
        "mjy_sr": {
          "description": "Brillo de superficie a 5σ en MJy/sr",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "magnitud": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Magnitud equivalente, si se puede calcular"
        }
      },
      "required": [
        "mjy_sr",
        "magnitud"
      ],
      "title": "Profundidad",
      "type": "object"
    },
    "PuntoDeRecuperacion": {
      "additionalProperties": false,
      "properties": {
        "brillo": {
          "type": "number"
        },
        "fraccion_recuperada": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "brillo",
        "fraccion_recuperada"
      ],
      "title": "PuntoDeRecuperacion",
      "type": "object"
    },
    "PuntoHeliocentrico": {
      "additionalProperties": false,
      "description": "Posición de un cuerpo en una época, centrada en el Sol (RF-34, RF-35).",
      "properties": {
        "epoca_id": {
          "description": "Identificador en kebab-case",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "x_ua": {
          "type": "number"
        },
        "y_ua": {
          "type": "number"
        },
        "z_ua": {
          "type": "number"
        }
      },
      "required": [
        "epoca_id",
        "x_ua",
        "y_ua",
        "z_ua"
      ],
      "title": "PuntoHeliocentrico",
      "type": "object"
    },
    "Rejilla": {
      "additionalProperties": false,
      "description": "Rejilla común norte arriba a la que se reproyectan todas las épocas.",
      "properties": {
        "ancho_px": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "alto_px": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "escala_arcsec_px": {
          "description": "Segundos de arco por píxel",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "wcs": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "Cabecera FITS TAN de la rejilla, como diccionario",
          "type": "object"
        }
      },
      "required": [
        "ancho_px",
        "alto_px",
        "escala_arcsec_px",
        "wcs"
      ],
      "title": "Rejilla",
      "type": "object"
    },
    "TextoTraducido": {
      "additionalProperties": false,
      "description": "Texto en los dos idiomas de la interfaz (RNF-06).",
      "properties": {
        "es": {
          "minLength": 1,
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "es",
        "en"
      ],
      "title": "TextoTraducido",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Raíz de `campo.json`.",
  "properties": {
    "id": {
      "description": "Identificador en kebab-case",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "nombre": {
      "$ref": "#/$defs/TextoTraducido"
    },
    "descripcion": {
      "$ref": "#/$defs/TextoTraducido"
    },
    "centro": {
      "$ref": "#/$defs/Coordenadas"
    },
    "tamano_grados": {
      "description": "Lado del campo en grados",
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "detector": {
      "enum": [
        "D1",
        "D2",
        "D3",
        "D4",
        "D5",
        "D6"
      ],
      "type": "string"
    },
    "rejilla": {
      "$ref": "#/$defs/Rejilla"
    },
    "estiramiento": {
      "$ref": "#/$defs/Estiramiento"
    },
    "epocas": {
      "description": "Ordenadas por mjd",
      "items": {
        "$ref": "#/$defs/Epoca"
      },
      "type": "array"
    },
    "referencia": {
      "anyOf": [
        {
          "description": "Ruta relativa a web/public/datos/ (o servida por la API en el modo en vivo)",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Mediana de las épocas"
    },
    "rastro": {
      "anyOf": [
        {
          "description": "Ruta relativa a web/public/datos/ (o servida por la API en el modo en vivo)",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Máximo por píxel (RF-17)"
    },
    "conocidos": {
      "items": {
        "$ref": "#/$defs/ObjetoConocido"
      },
      "type": "array"
    },
    "candidatos": {
      "items": {
        "$ref": "#/$defs/Candidato"
      },
      "type": "array"
    },
    "geometria": {
      "anyOf": [
        {
          "$ref": "#/$defs/Geometria"
        },
        {
          "type": "null"
        }
      ],
      "description": "Para la escena 3D; null si el campo no sigue un cuerpo del Sistema Solar"
    },
    "limites": {
      "anyOf": [
        {
          "$ref": "#/$defs/Limites"
        },
        {
          "type": "null"
        }
      ]
    },
    "avisos": {
      "items": {
        "$ref": "#/$defs/TextoTraducido"
      },
      "type": "array"
    },
    "creditos": {
      "minLength": 1,
      "type": "string"
    },
    "procedencia": {
      "$ref": "#/$defs/Procedencia"
    }
  },
  "required": [
    "id",
    "nombre",
    "descripcion",
    "centro",
    "tamano_grados",
    "detector",
    "rejilla",
    "estiramiento",
    "epocas",
    "referencia",
    "rastro",
    "conocidos",
    "candidatos",
    "geometria",
    "limites",
    "avisos",
    "creditos",
    "procedencia"
  ],
  "title": "Campo",
  "type": "object"
}
